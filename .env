# Farm2Future Frontend — Environment Variables

# When true (default), the app uses the in-memory mock data layer
# defined in src/api/__mocks__. Set to false to hit the real backend.
VITE_USE_MOCK=false

# Base URL of Yin Sizhe's real backend. Only used when VITE_USE_MOCK=false.
# Example for local dev: VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:7020